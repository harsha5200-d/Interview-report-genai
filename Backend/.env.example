# Copy to .env and fill in your values

MONGO_URI=mongodb://USER:PASSWORD@host1:27017,host2:27017,host3:27017/DATABASE?ssl=true&authSource=admin&retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_here
GOOGLE_GENAI_API_KEY=your_gemini_api_key_here
GROK_API_KEY=your_grok_api_key_here

# Local dev only — fixes TLS/certificate errors on some Windows networks
MONGODB_TLS_INSECURE=true
GOOGLE_AI_TLS_INSECURE=true

PORT=3000
